# ======================================================================
# REMOTAX — HIGH-PERFORMANCE PRODUCTION APACHE CONFIGURATION
# ======================================================================

# ----------------------------------------------------------------------
AddType application/manifest+json .webmanifest

# 1. Output Compression (Gzip & Brotli)
# ----------------------------------------------------------------------
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript
    AddOutputFilterByType DEFLATE application/javascript application/x-javascript application/json
    AddOutputFilterByType DEFLATE application/xml application/xhtml+xml application/rss+xml
    AddOutputFilterByType DEFLATE image/svg+xml font/woff2 application/manifest+json application/x-font-woff application/manifest+json
</IfModule>

<IfModule mod_brotli.c>
    AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/xml text/css text/javascript
    AddOutputFilterByType BROTLI_COMPRESS application/javascript application/x-javascript application/json
    AddOutputFilterByType BROTLI_COMPRESS image/svg+xml font/woff2 application/manifest+json
</IfModule>

# ----------------------------------------------------------------------
# 2. Caching Policies (Static Assets vs Dynamic HTML)
# ----------------------------------------------------------------------
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 month"
    ExpiresByType text/html "access plus 0 seconds"
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/avif "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"
    ExpiresByType application/manifest+json "access plus 1 week"
</IfModule>

<IfModule mod_headers.c>
    # Static Assets: 1 Year Cache with Immutable
    <FilesMatch "\.(css|js|woff2|woff|ttf|svg|png|jpg|jpeg|avif|webp|ico)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>

    # Dynamic HTML: must-revalidate + Early Hints / Link Preload Headers
    <FilesMatch "\.(html|htm)$">
        Header set Cache-Control "no-cache, must-revalidate, max-age=0"
        Header set Pragma "no-cache"
        Header set Expires "0"
        # Font preloads are handled per-page via <head> <link rel="preload">
    </FilesMatch>

    # ------------------------------------------------------------------
    # 3. Security Headers
    # ------------------------------------------------------------------
    Header set X-Content-Type-Options "nosniff"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    Header set Permissions-Policy "camera=(), microphone=(), geolocation=()"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set Cross-Origin-Opener-Policy "same-origin-allow-popups"
    # Shared domain afrix.ir -> NO includeSubDomains, NO preload
    Header set Strict-Transport-Security "max-age=31536000"
    # Content-Security-Policy & Clickjacking protection
    Header set Content-Security-Policy "default-src 'self' https: data: 'unsafe-inline' 'unsafe-eval'; img-src 'self' https: data: blob:; font-src 'self' data: https:; style-src 'self' 'unsafe-inline' https:; script-src 'self' 'unsafe-inline' 'unsafe-eval' https:; frame-ancestors 'self';"
</IfModule>

# ----------------------------------------------------------------------
# 4. Access Restrictions & Clean Routing
# ----------------------------------------------------------------------
Options -Indexes
RewriteEngine On
RewriteBase /remotax/

# --- REMOTAX WAVE 1 301 REDIRECTS START ---
# 301 Redirect legacy comparisons HTML to clean directory URL
RewriteRule ^comparisons/spain-vs-portugal\.html$ comparisons/spain-vs-portugal/ [R=301,L]

# 301 Redirect legacy country calculators to modern country hubs
RewriteRule ^tax-calculator/spain(?:\.html)?$ countries/spain/ [R=301,L]
RewriteRule ^tax-calculator/portugal(?:\.html)?$ countries/portugal/ [R=301,L]
RewriteRule ^tax-calculator/uae(?:\.html)?$ countries/uae/ [R=301,L]

# 301 Redirect legacy regime articles to modern regime hubs
RewriteRule ^article-spain-beckham-law(?:\.html)?$ regimes/beckham-law-spain/ [R=301,L]
RewriteRule ^article-portugal-d8-nhr(?:\.html)?$ regimes/ifici-portugal/ [R=301,L]
RewriteRule ^article-dubai-zero-tax(?:\.html)?$ regimes/dubai-virtual-working-programme/ [R=301,L]
RewriteRule ^article-italy-impatriati-tax(?:\.html)?$ regimes/impatriati-italy/ [R=301,L]
RewriteRule ^article-thailand-dtv-visa(?:\.html)?$ regimes/thailand-dtv/ [R=301,L]

# 301 Redirect reverse comparison pairs to canonical pair URLs
RewriteRule ^comparisons/portugal-vs-spain/?$ comparisons/spain-vs-portugal/ [R=301,L]
RewriteRule ^comparisons/uae-vs-spain/?$ comparisons/spain-vs-uae/ [R=301,L]
RewriteRule ^comparisons/italy-vs-spain/?$ comparisons/spain-vs-italy/ [R=301,L]
RewriteRule ^comparisons/thailand-vs-spain/?$ comparisons/spain-vs-thailand/ [R=301,L]
RewriteRule ^comparisons/uae-vs-portugal/?$ comparisons/portugal-vs-uae/ [R=301,L]
RewriteRule ^comparisons/italy-vs-portugal/?$ comparisons/portugal-vs-italy/ [R=301,L]
RewriteRule ^comparisons/thailand-vs-portugal/?$ comparisons/portugal-vs-thailand/ [R=301,L]
RewriteRule ^comparisons/italy-vs-uae/?$ comparisons/uae-vs-italy/ [R=301,L]
RewriteRule ^comparisons/thailand-vs-uae/?$ comparisons/uae-vs-thailand/ [R=301,L]
RewriteRule ^comparisons/thailand-vs-italy/?$ comparisons/italy-vs-thailand/ [R=301,L]
# --- REMOTAX WAVE 1 301 REDIRECTS END ---

# Block direct web access to tests, scratch, reports, review, content, templates, scripts and dev files
RewriteRule ^(tests|scratch|reports|review|node_modules|content|templates|scripts|\.git)(/|$) - [F,L]
RewriteRule ^(\.cpanel\.yml|\.env|package\.json|package-lock\.json|generate\.js|check\.js|build\.js|verify_mobile\.js|test_suite\.js|generator\.config\.json|redirects\.csv|.*\.zip|.*\.md|.*\.csv)$ - [F,L]

<FilesMatch "(^\..*|package\.json|package-lock\.json|generate\.js|check\.js|build\.js|verify_mobile\.js|test_suite\.js|generator\.config\.json|redirects\.csv|\.zip|\.md|\.csv)$">
    Require all denied
</FilesMatch>

RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.html -f
RewriteRule ^(.*)$ $1.html [NC,L]

ErrorDocument 404 /remotax/404.html
